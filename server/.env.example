PORT=5000
# Set to "production" on your host. Demo data is auto-disabled when NODE_ENV=production.
NODE_ENV=development
# Seed demo teacher/admin accounts and sample content.
# Default is enabled in development and disabled in production; set true only for demo environments.
SEED_DEMO_DATA=false
JWT_SECRET=testcraft_jwt_super_secret_key_change_in_production
MONGODB_URI=
MONGODB_DB_NAME=testcraft
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hard cap for an AI request before falling back to the local generator.
AI_TIMEOUT_MS=25000
OPENAI_API_KEY=
GOOGLE_BOOKS_API_KEY=
UPLOAD_MAX_SIZE_MB=50

# Frontend URL used in password reset links
CLIENT_URL=http://localhost:5173

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173

# Number of trusted reverse-proxy hops (Render/Netlify = 1). Set to "false" locally if unsure.
TRUST_PROXY_HOPS=1

# Optional rate-limit overrides
GENERATION_RATE_LIMIT=40
LOGIN_RATE_LIMIT=50
REGISTER_RATE_LIMIT=10
FORGOT_RATE_LIMIT=10
RESET_RATE_LIMIT=20

# Optional SMTP configuration for password reset and support notification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
